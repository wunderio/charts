{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "branchName": { "type": "string" },
    "downscaler": { "type": "object" },
    "ingressAccess": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "additionalPodSelector": { "type": "object" },
          "from": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "proxy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean"},
        "url":     { "type": "string"},
        "port": { "type": "integer"},
        "no_proxy": { "type": "string"}
      }
    },
    "global": { "type": "object" },
    "github": {
      "type": "object",
      "properties": {
        "prComment": {
          "type": "object",
          "properties": {
            "prNumber": { "type": "string" },
            "repository": { "type": "string" },
            "enabled": { "type": "boolean" },
            "environmentUrl": { "type": "string" },
            "secretName": { "type": "string" },
            "commentTag": { "type": "string" }
          }
        }
      }
    }
  }
}
